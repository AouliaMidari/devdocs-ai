# Exemple de configuration DevDocs AI (ce fichier est versionne, sans secret)
# Pour l'utiliser : Copy-Item .env.example .env, puis remplir .env
# Ne jamais versionner le fichier .env : il contiendra des secrets.

# Environnement : development, test ou production
DEVDOCS_ENVIRONMENT=development

# Niveau de logs : DEBUG, INFO, WARNING ou ERROR
DEVDOCS_LOG_LEVEL=INFO

# Nombre de passages renvoyes par le retriever (entre 1 et 50)
DEVDOCS_RETRIEVAL_TOP_K=5

# Cle API du LLM (etape 11). Laisser vide tant qu'aucun LLM n'est choisi.
DEVDOCS_LLM_API_KEY=
